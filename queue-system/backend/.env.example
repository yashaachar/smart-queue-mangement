# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=queueuser
PG_PASSWORD=queuepass
PG_DATABASE=queuedb

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongouser:mongopass@localhost:27017/queue_logs?authSource=admin

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_before_production
JWT_EXPIRES_IN=24h
